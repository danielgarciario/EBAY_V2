{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log.txt",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 5
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Sample"
    }
  },
  "EBAYTrading": {
    "AppId": "YOUR_EBAY_APP_ID",
    "DevId": "YOUR_EBAY_DEV_ID",
    "CertId": "YOUR_EBAY_CERT_ID",
    "AuthToken": "YOUR_EBAY_AUTH_TOKEN"
  }
}
